# Kit API v4. Create an API key in Kit and add it to Vercel Environment Variables.
KIT_API_KEY=
# Optional fallback tag ID.
KIT_TAG_ID=
# Optional custom field key in Kit. Create it first if you want source stored as a field.
KIT_SOURCE_FIELD_KEY=source
# Optional per-source tags. The website will use these tag names.
KIT_TAG_NEWSLETTER_ID=
KIT_TAG_MARKETING_STRATEGY_ID=
KIT_TAG_B2B_ID=
KIT_TAG_B2C_ID=
KIT_TAG_GROWTH_ID=
KIT_TAG_BRAND_ID=
KIT_TAG_PRODUCT_MARKETING_ID=
KIT_TAG_GTM_ID=
KIT_TAG_CRM_RETENTION_ID=
KIT_TAG_SEO_ID=
KIT_TAG_RESOURCE_ID=
KIT_TAG_CRM_ID=
KIT_TAG_CONSULTING_ID=
KIT_TAG_SMALL_BUSINESS_ID=
